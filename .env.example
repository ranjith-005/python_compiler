# Copy to .env and adjust. If SECRET_KEY is missing, one is generated into .env
# on first start (changing it later invalidates every existing session).
SECRET_KEY=change-me-to-a-long-random-string

# Session
SESSION_DAYS=7
COOKIE_SECURE=0            # set to 1 when serving over HTTPS

# Storage
DB_PATH=pycompiler.db
WORKSPACE_ROOT=workspaces  # per-user folders; also each kernel's working directory

# Notebook runtime (one IPython kernel per user)
KERNEL_STARTUP_SEC=60
CELL_TIMEOUT_SEC=120       # a cell is interrupted after this long
KERNEL_IDLE_TIMEOUT_SEC=1800
MAX_LIVE_KERNELS=8
MAX_CELLS_PER_NOTEBOOK=500
MAX_NOTEBOOKS_PER_USER=200
MAX_OUTPUT_BYTES_PER_CELL=4000000

# Uploaded files
MAX_UPLOAD_BYTES=200000000
MAX_WORKSPACE_BYTES=1000000000

# Groq: structures an uploaded PDF/PPT/PPTX into learning sections.
# Optional. With no key the upload still works -- the sections are grouped
# offline instead, and the trainer is told so on the review page.
# Never commit a real key: .env is gitignored, .env.example is not.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SEC=90
GROQ_RETRIES=3            # transient 429/5xx/timeouts before falling back
GROQ_BACKOFF_SEC=2        # doubles each retry
GROQ_CHUNK_WORDS=2500     # words per request; a long deck is split on this

# Outbound mail: the welcome a newly enrolled student receives.
# Optional. With no SMTP_HOST the enrolment still works -- nothing is sent and
# the trainer gets a mailto: link to send from their own client instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=1          # 0 when using SMTP_SSL, or a relay on port 25
SMTP_SSL=0               # 1 for implicit TLS, usually port 465
SMTP_TIMEOUT_SEC=20
MAIL_FROM=               # the From address; relays often send as a different identity than SMTP_USER
