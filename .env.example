# Copy to .env and adjust. If SECRET_KEY is missing, one is generated into .env
# on first start (changing it later invalidates every existing session).
SECRET_KEY=change-me-to-a-long-random-string

# Session
SESSION_DAYS=7
COOKIE_SECURE=0            # set to 1 when serving over HTTPS

# Storage. Defaults are data/ in the project folder; under Docker these are
# fixed to the /srv/data volume by docker-compose.yml, so leave them unset.
# DB_PATH=data/pycompiler.db
# WORKSPACE_ROOT=data/workspaces
# MODULE_SOURCE_ROOT=data/module_sources

# A student's Run/Submit is stopped after min(this, 15) seconds
CELL_TIMEOUT_SEC=120

# Groq: structures an uploaded PDF/PPT/PPTX into learning sections.
# Optional. With no key the upload still works -- the sections are grouped
# offline instead, and the trainer is told so on the review page.
# Never commit a real key: .env is gitignored, .env.example is not.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SEC=90
GROQ_RETRIES=3            # transient 429/5xx/timeouts before falling back
GROQ_BACKOFF_SEC=2        # doubles each retry
GROQ_CHUNK_WORDS=2500     # words per request; a long deck is split on this
