# Copy to .env and adjust. If SECRET_KEY is missing, one is generated into .env
# on first start (changing it later invalidates every existing session).
SECRET_KEY=change-me-to-a-long-random-string

# Session
SESSION_DAYS=7
COOKIE_SECURE=0            # set to 1 when serving over HTTPS

# Storage
DB_PATH=pycompiler.db
WORKSPACE_ROOT=workspaces  # per-user folders; also each kernel's working directory

# Notebook runtime (one IPython kernel per user)
KERNEL_STARTUP_SEC=60
CELL_TIMEOUT_SEC=120       # a cell is interrupted after this long
KERNEL_IDLE_TIMEOUT_SEC=1800
MAX_LIVE_KERNELS=8
MAX_CELLS_PER_NOTEBOOK=500
MAX_NOTEBOOKS_PER_USER=200
MAX_OUTPUT_BYTES_PER_CELL=4000000

# Uploaded files
MAX_UPLOAD_BYTES=200000000
MAX_WORKSPACE_BYTES=1000000000
